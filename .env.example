# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LOCALPRO_DB_PATH: Optional filesystem path for the SQLite database file.
# Set to a persistent volume path in production deployments (defaults to ./localpro.db).
LOCALPRO_DB_PATH="./localpro.db"

# LOCALPRO_UPLOAD_DIR: Optional directory for uploaded avatar and post images.
# Set to a persistent volume directory in production deployments (defaults to ./uploads).
LOCALPRO_UPLOAD_DIR="./uploads"

# ALLOWED_ORIGINS: Optional comma-separated list of trusted frontend origins for CORS in production.
# Example: ALLOWED_ORIGINS="https://localpro.example.com"
ALLOWED_ORIGINS=""

# CSP_FRAME_ANCESTORS: Optional Content-Security-Policy frame-ancestors directive value.
# Set to 'none' in standalone production deployments if framing is not needed.
CSP_FRAME_ANCESTORS="'self' https://aistudio.google.com https://*.googleusercontent.com"

# SESSION_IDLE_TIMEOUT_MINUTES: Inactivity timeout for authenticated sessions (default 1440 = 24h).
SESSION_IDLE_TIMEOUT_MINUTES="1440"

# Option A — Gmail SMTP (recommended with a Google 16-character App Password):
# Set GMAIL_USER and GMAIL_APP_PASSWORD in the AI Studio Secrets panel.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Option B — Generic SMTP_* (Optional): Configure any custom SMTP relay instead of Gmail.
# Leave blank in local development if email delivery is not yet connected.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="LocalPro <no-reply@localpro.local>"

